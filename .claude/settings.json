{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": [
    "codegraph"
  ],
  "permissions": {
    "allow": [
      "Bash(command -v openspec)",
      "Bash(command -v mvn)",
      "Bash(command -v java)",
      "Bash(npm root -g)",
      "Bash(pwd)",
      "Bash(mvn -v)",
      "Bash(mvn -o validate)",
      "Bash(mvn -o -q validate)",
      "Bash(mvn -o test)",
      "Bash(mvn -o -q test)",
      "Bash(mvn -o -q -Dtest=* test)",
      "Bash(openspec --version)",
      "Bash(openspec --help)",
      "Bash(openspec init --help)",
      "Bash(openspec update --help)",
      "Bash(openspec config --help)",
      "Bash(openspec config list)",
      "Bash(openspec doctor:*)",
      "Bash(openspec context:*)",
      "Bash(openspec list:*)",
      "Bash(openspec status:*)",
      "Bash(openspec instructions:*)",
      "Bash(openspec validate:*)",
      "Bash(openspec schemas:*)",
      "Bash(openspec templates:*)",
      "Bash(codegraph explore:*)",
      "Bash(git status:*)",
      "Bash(git -C * status:*)",
      "Bash(git diff:*)",
      "Bash(git -C * diff:*)",
      "Bash(git show:*)",
      "Bash(git -C * show:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git log:*)",
      "Bash(git check-ignore:*)",
      "Bash(git branch --show-current)",
      "Bash(git remote -v)",
      "Bash(git merge-base:*)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse:*)",
      "Bash(find .:*)",
      "Bash(ls:*)",
      "Bash(file:*)",
      "Bash(ps:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(tr:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(readlink:*)",
      "Bash(sed -n:*)",
      "Bash(test -f:*)",
      "Bash(test -d:*)",
      "Bash(test -L:*)",
      "Bash(test -e:*)",
      "Bash(find -L .claude/skills .kiro/skills -maxdepth 1 -type l -print)",
      "mcp__codegraph__codegraph_explore"
    ]
  }
}
